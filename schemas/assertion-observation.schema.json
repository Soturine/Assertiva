{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Assertiva Assertion Observation",
  "type": "object",
  "required": [
    "observation_id",
    "surface",
    "oracle_source"
  ],
  "properties": {
    "observation_id": {
      "type": "string"
    },
    "test_invocation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "surface": {
      "enum": [
        "return_value",
        "error",
        "warning",
        "state",
        "persistence",
        "interaction",
        "event",
        "http",
        "routing",
        "template",
        "context",
        "rendered_content",
        "dom",
        "accessibility",
        "visual",
        "storage",
        "filesystem",
        "network",
        "telemetry",
        "performance",
        "security",
        "other"
      ]
    },
    "oracle_source": {
      "type": "string"
    },
    "assertion_form": {
      "type": [
        "string",
        "null"
      ]
    },
    "strength_notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "provenance": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": true
}
