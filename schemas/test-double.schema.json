{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Assertiva Test Double",
  "type": "object",
  "required": [
    "double_id",
    "kind",
    "target_boundary"
  ],
  "properties": {
    "double_id": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "dummy",
        "stub",
        "fake",
        "spy",
        "mock",
        "patch",
        "virtualizer",
        "emulator",
        "simulator",
        "other"
      ]
    },
    "target_boundary": {
      "type": "string"
    },
    "lookup_or_injection_seam": {
      "type": [
        "string",
        "null"
      ]
    },
    "api_constrained": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "claim_impact": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "provenance": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": true
}
