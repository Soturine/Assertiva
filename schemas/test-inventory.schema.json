{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Assertiva Test Inventory",
  "type": "object",
  "required": [
    "definition_id",
    "discovery_status"
  ],
  "properties": {
    "definition_id": {
      "type": "string"
    },
    "source": {
      "type": [
        "string",
        "null"
      ]
    },
    "runner": {
      "type": [
        "string",
        "null"
      ]
    },
    "framework": {
      "type": [
        "string",
        "null"
      ]
    },
    "discovery_status": {
      "enum": [
        "COMPLETE",
        "PARTIAL",
        "DYNAMIC",
        "UNKNOWN"
      ]
    },
    "dynamic": {
      "type": "boolean"
    },
    "parameterized": {
      "type": "boolean"
    },
    "invocation_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
