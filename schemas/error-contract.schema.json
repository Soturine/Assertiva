{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Assertiva Error Contract",
  "type": "object",
  "properties": {
    "category": {
      "type": [
        "string",
        "null"
      ]
    },
    "error_type": {
      "type": [
        "string",
        "null"
      ]
    },
    "code": {
      "type": [
        "string",
        "null"
      ]
    },
    "path": {
      "type": "array",
      "items": {
        "type": [
          "string",
          "integer"
        ]
      }
    },
    "status": {
      "type": [
        "string",
        "integer",
        "null"
      ]
    },
    "context": {
      "type": "object"
    },
    "message_policy": {
      "enum": [
        "exact",
        "pattern",
        "semantic",
        "not_asserted",
        "unknown"
      ]
    },
    "sanitized_input_class": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": true
}
