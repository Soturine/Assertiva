{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Assertiva Assurance Report",
  "type": "object",
  "required": [
    "report_version",
    "project",
    "states",
    "findings",
    "claim_boundary"
  ],
  "properties": {
    "report_version": {
      "type": "string"
    },
    "project": {
      "type": "object",
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "dirty": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "digest": {
          "type": [
            "string",
            "null"
          ],
          "description": "Content digest of the audited project files; an assessment is refused when the project no longer matches it."
        }
      },
      "additionalProperties": true
    },
    "states": {
      "type": "object",
      "properties": {
        "current": {
          "type": [
            "object",
            "null"
          ]
        },
        "baseline": {
          "type": [
            "object",
            "null"
          ]
        },
        "candidate": {
          "type": [
            "object",
            "null"
          ]
        },
        "applied": {
          "type": [
            "object",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "summary",
          "severity"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Stable within the run: the code, suffixed when it repeats; agent findings are 'agent:<slug>'."
          },
          "code": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "origin": {
            "enum": [
              "engine",
              "agent"
            ]
          },
          "severity": {
            "enum": [
              "high",
              "medium",
              "low",
              "info"
            ],
            "description": "Engine default for the code (agent findings: the agent's priority). Never rewritten by an assessment."
          },
          "priority": {
            "enum": [
              "high",
              "medium",
              "low",
              "info",
              "none"
            ],
            "description": "Effective priority: the severity unless an assessment restates it; 'none' for a false positive."
          },
          "evidence": {
            "type": "object"
          },
          "assessment": {
            "type": "object",
            "description": "The auditing agent's disposition of an engine finding.",
            "properties": {
              "disposition": {
                "enum": [
                  "CONFIRMED",
                  "PARTIAL",
                  "CONTEXTUAL",
                  "FALSE_POSITIVE",
                  "UNRESOLVED"
                ]
              },
              "priority": {
                "enum": [
                  "high",
                  "medium",
                  "low",
                  "info"
                ]
              },
              "rationale": {
                "type": "string"
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "scope": {
                "type": "object",
                "properties": {
                  "reviewed": {
                    "type": "integer"
                  },
                  "of": {
                    "type": "integer"
                  }
                }
              },
              "subjects": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              }
            }
          },
          "title": {
            "type": "string"
          },
          "why": {
            "type": "string"
          },
          "basis": {
            "enum": [
              "OBSERVED",
              "DECLARED",
              "INFERRED"
            ]
          },
          "recommendation": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "evidence_delta": {
      "type": "object",
      "properties": {
        "improved": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "unchanged": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "regressed": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "unknown": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "changed": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "Contextual metrics that changed without a defensible better/worse direction."
        }
      },
      "additionalProperties": true
    },
    "change_set": {
      "type": [
        "object",
        "null"
      ]
    },
    "claim_boundary": {
      "type": "object",
      "required": [
        "observed",
        "not_evidenced"
      ],
      "properties": {
        "observed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "not_evidenced": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "provenance": {
      "type": "object"
    },
    "candidate_qualification": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "ready_for_review": {
          "type": "boolean"
        },
        "stages": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "stage",
              "status",
              "checks"
            ],
            "properties": {
              "stage": {
                "enum": [
                  "EXECUTION",
                  "BEHAVIORAL_ASSURANCE",
                  "FAULT_SENSITIVITY",
                  "DELIVERY_FIDELITY",
                  "STABILITY_AND_COST"
                ]
              },
              "status": {
                "enum": [
                  "PASS",
                  "FAIL",
                  "BLOCKED",
                  "NOT_RUN",
                  "UNKNOWN"
                ]
              },
              "summary": {
                "type": "string"
              },
              "checks": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "check",
                    "status",
                    "summary"
                  ],
                  "properties": {
                    "check": {
                      "type": "string"
                    },
                    "status": {
                      "enum": [
                        "PASS",
                        "FAIL",
                        "BLOCKED",
                        "NOT_RUN",
                        "UNKNOWN"
                      ]
                    },
                    "summary": {
                      "type": "string"
                    },
                    "evidence_refs": {
                      "type": "array"
                    },
                    "limitations": {
                      "type": "array"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "additionalProperties": true
    },
    "remaining_unknowns": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Evidence that was not produced: UNKNOWN/NOT_RUN/BLOCKED stages and unmeasured metrics."
    },
    "workflow": {
      "enum": [
        "audit",
        "improve"
      ]
    },
    "status": {
      "type": "string"
    },
    "generated_at": {
      "type": "string"
    },
    "recommendations": {
      "type": "array"
    },
    "verification_surface": {
      "type": "array"
    },
    "applied_delta": {
      "type": [
        "object",
        "null"
      ]
    },
    "execution_budget": {
      "type": [
        "object",
        "null"
      ]
    },
    "report_path": {
      "type": "string"
    },
    "test_selection": {
      "type": [
        "object",
        "null"
      ],
      "description": "impact-based selection: selected/not_selected with reasons, widening, confidence category"
    },
    "history": {
      "type": [
        "object",
        "null"
      ],
      "description": "history signals: stability per invocation, fingerprints, durations, previous state"
    },
    "delivery": {
      "type": [
        "object",
        "null"
      ],
      "description": "declared vs CI-selected matrix and artifact lineage"
    },
    "review_candidates": {
      "type": [
        "array",
        "null"
      ],
      "description": "concentrations for human review; never findings or gates"
    },
    "run_id": {
      "type": "string",
      "description": "Identity of one audit run; an attached assessment must name it."
    },
    "assessment": {
      "type": [
        "object",
        "null"
      ],
      "description": "The auditing agent's assessment attached with `assertiva audit --assessment`.",
      "properties": {
        "source": {
          "const": "agent"
        },
        "attached_at": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "lang": {
          "type": [
            "string",
            "null"
          ]
        },
        "unknowns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dispositions": {
          "type": "integer"
        },
        "findings": {
          "type": "integer"
        }
      }
    },
    "declared_checks": {
      "type": "array",
      "description": "Discovered checks reproduced on request (`audit --run-check`) in a disposable copy.",
      "items": {
        "type": "object",
        "required": [
          "check_id",
          "status"
        ],
        "properties": {
          "check_id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "origin": {
            "type": "string"
          },
          "command": {
            "type": [
              "string",
              "null"
            ]
          },
          "gate": {
            "type": "string"
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "BLOCKED",
              "NOT_RUN"
            ]
          },
          "detail": {
            "type": "string"
          },
          "limitation": {
            "type": "string"
          }
        }
      }
    }
  },
  "additionalProperties": false
}
