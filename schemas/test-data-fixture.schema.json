{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Assertiva Test Data Fixture",
  "type": "object",
  "required": [
    "fixture_id",
    "kind"
  ],
  "properties": {
    "fixture_id": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "inline",
        "parameter",
        "static_fixture",
        "factory",
        "builder",
        "framework_fixture",
        "generated",
        "property_strategy",
        "fuzz_corpus",
        "production_derived",
        "other"
      ]
    },
    "scope": {
      "type": [
        "string",
        "null"
      ]
    },
    "mutable": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "seed": {
      "type": [
        "string",
        "integer",
        "null"
      ]
    },
    "version": {
      "type": [
        "string",
        "null"
      ]
    },
    "reset_strategy": {
      "type": [
        "string",
        "null"
      ]
    },
    "shared_state_risk": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "provenance": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": true
}
