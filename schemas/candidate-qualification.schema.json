{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Assertiva Candidate Qualification",
  "type": "object",
  "required": ["baseline_revision", "changes", "stages", "metric_deltas"],
  "properties": {
    "baseline_revision": {"type": ["string", "null"]},
    "candidate_revision": {"type": ["string", "null"]},
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["change_id", "path", "kind", "original_preserved", "human_approval_required"],
        "properties": {
          "change_id": {"type": "string"},
          "path": {"type": "string"},
          "kind": {"enum": ["ADD", "MODIFY", "RETIRE_CANDIDATE"]},
          "reason": {"type": "string"},
          "original_fingerprint": {"type": ["string", "null"]},
          "original_preserved": {"type": "boolean"},
          "human_approval_required": {"const": true}
        },
        "additionalProperties": true
      }
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["stage", "status"],
        "properties": {
          "stage": {
            "enum": [
              "STATIC_AND_DISCOVERY",
              "CANDIDATE_TESTS",
              "ORIGINAL_REGRESSION",
              "COVERAGE_AND_ORACLES",
              "NEGATIVE_PATHS",
              "MUTATION_OR_NEGATIVE_CONTROLS",
              "PIPELINE_EQUIVALENT",
              "BUILD_AND_ARTIFACT",
              "PREVIEW_DEPLOY",
              "STABILITY_AND_COST"
            ]
          },
          "status": {"enum": ["PASS", "FAIL", "BLOCKED", "NOT_RUN", "UNKNOWN"]},
          "summary": {"type": "string"},
          "evidence_refs": {"type": "array", "items": {"type": "string"}},
          "limitations": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    },
    "metric_deltas": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "state"],
        "properties": {
          "name": {"type": "string"},
          "baseline": {"type": ["number", "integer", "null"]},
          "candidate": {"type": ["number", "integer", "null"]},
          "state": {"enum": ["IMPROVED", "REGRESSED", "UNCHANGED", "CHANGED", "UNKNOWN"]},
          "unit": {"type": ["string", "null"]}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
