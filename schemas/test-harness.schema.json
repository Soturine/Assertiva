{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Assertiva Test Harness",
  "type": "object",
  "required": [
    "harness_id"
  ],
  "properties": {
    "harness_id": {
      "type": "string"
    },
    "execution_boundary": {
      "type": [
        "string",
        "null"
      ]
    },
    "process_boundary": {
      "type": [
        "string",
        "null"
      ]
    },
    "transport": {
      "type": [
        "string",
        "null"
      ]
    },
    "persistence": {
      "type": [
        "string",
        "null"
      ]
    },
    "transaction_semantics": {
      "type": [
        "string",
        "null"
      ]
    },
    "external_dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ui_runtime": {
      "type": [
        "string",
        "null"
      ]
    },
    "matrix": {
      "type": "object"
    },
    "isolation_scope": {
      "type": [
        "string",
        "null"
      ]
    },
    "reset_strategy": {
      "type": [
        "string",
        "null"
      ]
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "provenance": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": true
}
