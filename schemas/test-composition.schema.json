{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Assertiva Test Composition Relation",
  "type": "object",
  "required": ["declaration_id", "materialization_id", "relation", "evidence_tier"],
  "properties": {
    "declaration_id": {"type": "string"},
    "materialization_id": {"type": "string"},
    "relation": {
      "enum": ["INHERITS_FROM", "COMPOSES", "MATERIALIZES_IN", "OVERRIDES", "EXTENDS", "PARAMETERIZES", "GENERATES"]
    },
    "source": {"type": ["string", "null"]},
    "evidence_tier": {"enum": ["E0", "E1", "E2", "E3", "E4"]},
    "discovery_status": {"enum": ["COMPLETE", "PARTIAL", "DYNAMIC", "UNKNOWN"]},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "context": {"type": "object"}
  },
  "additionalProperties": true
}
