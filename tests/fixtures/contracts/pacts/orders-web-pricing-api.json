{
  "consumer": {
    "name": "orders-web"
  },
  "interactions": [
    {
      "description": "a member discount",
      "pending": false,
      "providerStates": [
        {
          "name": "a member order of 150.00"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/discount",
        "query": {
          "member": [
            "true"
          ],
          "total": [
            "15000"
          ]
        }
      },
      "response": {
        "body": {
          "content": {
            "discount": 1500
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "matchingRules": {
          "body": {
            "$.discount": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            }
          }
        },
        "status": 200
      },
      "type": "Synchronous/HTTP"
    },
    {
      "description": "an unknown order",
      "pending": false,
      "providerStates": [
        {
          "name": "no order 999"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/orders/999"
      },
      "response": {
        "status": 404
      },
      "type": "Synchronous/HTTP"
    }
  ],
  "metadata": {
    "pactRust": {
      "ffi": "0.5.10",
      "models": "1.3.16"
    },
    "pactSpecification": {
      "version": "4.0"
    }
  },
  "provider": {
    "name": "pricing-api"
  }
}