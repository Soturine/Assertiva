{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Assertiva Failure Cluster",
  "type": "object",
  "required": ["cluster_id", "test_ids", "hypothesis"],
  "properties": {
    "cluster_id": {"type": "string"},
    "test_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "component": {"type": ["string", "null"]},
    "root_exception": {"type": ["string", "null"]},
    "source": {"type": ["string", "null"]},
    "hypothesis": {"type": "string"},
    "confidence": {"enum": ["low", "medium", "high", "unknown"]},
    "evidence_refs": {"type": "array", "items": {"type": "string"}},
    "outliers": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
