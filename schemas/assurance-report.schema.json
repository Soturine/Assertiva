{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Assertiva Assurance Report",
  "type": "object",
  "required": [
    "report_version",
    "project",
    "states",
    "findings",
    "claim_boundary"
  ],
  "properties": {
    "report_version": {
      "type": "string"
    },
    "project": {
      "type": "object",
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "dirty": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "states": {
      "type": "object",
      "properties": {
        "current": {
          "type": [
            "object",
            "null"
          ]
        },
        "baseline": {
          "type": [
            "object",
            "null"
          ]
        },
        "candidate": {
          "type": [
            "object",
            "null"
          ]
        },
        "applied": {
          "type": [
            "object",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "evidence_delta": {
      "type": "object",
      "properties": {
        "improved": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "unchanged": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "regressed": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "unknown": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "changed": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "Contextual metrics that changed without a defensible better/worse direction."
        }
      },
      "additionalProperties": true
    },
    "change_set": {
      "type": [
        "object",
        "null"
      ]
    },
    "claim_boundary": {
      "type": "object",
      "required": [
        "observed",
        "not_evidenced"
      ],
      "properties": {
        "observed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "not_evidenced": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "provenance": {
      "type": "object"
    },
    "candidate_qualification": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "ready_for_review": {
          "type": "boolean"
        },
        "stages": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "stage",
              "status",
              "checks"
            ],
            "properties": {
              "stage": {
                "enum": [
                  "EXECUTION",
                  "BEHAVIORAL_ASSURANCE",
                  "FAULT_SENSITIVITY",
                  "DELIVERY_FIDELITY",
                  "STABILITY_AND_COST"
                ]
              },
              "status": {
                "enum": [
                  "PASS",
                  "FAIL",
                  "BLOCKED",
                  "NOT_RUN",
                  "UNKNOWN"
                ]
              },
              "summary": {
                "type": "string"
              },
              "checks": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "check",
                    "status",
                    "summary"
                  ],
                  "properties": {
                    "check": {
                      "type": "string"
                    },
                    "status": {
                      "enum": [
                        "PASS",
                        "FAIL",
                        "BLOCKED",
                        "NOT_RUN",
                        "UNKNOWN"
                      ]
                    },
                    "summary": {
                      "type": "string"
                    },
                    "evidence_refs": {
                      "type": "array"
                    },
                    "limitations": {
                      "type": "array"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "additionalProperties": true
    },
    "remaining_unknowns": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Evidence that was not produced: UNKNOWN/NOT_RUN/BLOCKED stages and unmeasured metrics."
    },
    "workflow": {
      "enum": [
        "audit",
        "improve"
      ]
    },
    "status": {
      "type": "string"
    },
    "generated_at": {
      "type": "string"
    },
    "recommendations": {
      "type": "array"
    },
    "verification_surface": {
      "type": "array"
    },
    "applied_delta": {
      "type": [
        "object",
        "null"
      ]
    },
    "execution_budget": {
      "type": [
        "object",
        "null"
      ]
    },
    "report_path": {
      "type": "string"
    },
    "test_selection": {
      "type": [
        "object",
        "null"
      ],
      "description": "impact-based selection: selected/not_selected with reasons, widening, confidence category"
    },
    "history": {
      "type": [
        "object",
        "null"
      ],
      "description": "history signals: stability per invocation, fingerprints, durations, previous state"
    },
    "delivery": {
      "type": [
        "object",
        "null"
      ],
      "description": "declared vs CI-selected matrix and artifact lineage"
    },
    "review_candidates": {
      "type": [
        "array",
        "null"
      ],
      "description": "concentrations for human review; never findings or gates"
    }
  },
  "additionalProperties": false
}
