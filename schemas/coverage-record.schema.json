{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Assertiva Coverage Record",
  "type": "object",
  "required": [
    "metric",
    "scope",
    "covered",
    "total"
  ],
  "properties": {
    "tool": {
      "type": [
        "string",
        "null"
      ]
    },
    "tool_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "metric": {
      "enum": [
        "statement",
        "line",
        "branch",
        "decision",
        "condition",
        "function",
        "method",
        "instruction",
        "path",
        "test_specific",
        "mutation",
        "other"
      ]
    },
    "scope": {
      "type": "string"
    },
    "covered": {
      "type": "number",
      "minimum": 0
    },
    "missed": {
      "type": "number",
      "minimum": 0
    },
    "total": {
      "type": "number",
      "minimum": 0
    },
    "ratio": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "aggregate": {
      "type": "boolean"
    },
    "revision": {
      "type": [
        "string",
        "null"
      ]
    },
    "exclusions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "artifact_ref": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": true
}
